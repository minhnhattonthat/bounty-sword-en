 {
  "id": "1DEE17",
  "kind": "text",
  "jp": "　{FF06:ED2D:00DD}に守られし者よ，{FF01}　なんじに預けたい男がいる。{FF10:ECA9:00DD}{FF11}{FF03}",
  "en": " One guarded by {FF06:ED2D:00DD},{FF01} I entrust a man to thee.{FF10:ECA9:00DD}{FF11}{FF03}"
 },
 {
  "id": "1DEE57",
  "kind": "text",
  "jp": "　宿命に敗れ，戦いにせを向けた男だ。{FF10:ECA9:00DD}{FF11}{FF03}",
  "en": " A man beaten by his fate,{FF01} who turned his back on war.{FF10:ECA9:00DD}{FF11}{FF03}"
 },
 {
  "id": "1DEE85",
  "kind": "text",
  "jp": "　なんじにこの男の運命をゆだねる。{FF01}　この男に名前を付けてくれ。{FF10:ECA9:00DD}{FF11}{FF0D}",
  "en": " His fate is in thy hands.{FF01} Give this man a name.{FF10:ECA9:00DD}{FF11}{FF0D}"
 },
 {
  "id": "1DEECF",
  "kind": "text",
  "jp": "{FF03}",
  "en": ""
 },
 {
  "id": "1DEED1",
  "kind": "text",
  "jp": "　{FF06:4D1B:007E}とは良い名だ。{FF01}　{FF06:4D1B:007E}をなんじに預ける。{FF10:ECA9:00DD}{FF11}{FF03}",
  "en": " {FF06:4D1B:007E} is a good name.{FF01} We entrust {FF06:4D1B:007E} to thee.{FF10:ECA9:00DD}{FF11}{FF03}"
 },
 {
  "id": "1DEF0D",
  "kind": "text",
  "jp": "　エウロペアの大地と我ら十二神の名において，{FF01}　そなたに祝福あれ°{FF04:001E}{FF0F}°{FF04:001E}{FF0F}°{FF04:001E}{FF0F}°{FF04:001E}{FF0F}{FF0D}",
  "en": " In the name of Europea and{FF01} the Twelve, be blessed.{FF04:001E}{FF0F}.{FF04:001E}{FF0F}.{FF04:001E}{FF0F}.{FF04:001E}{FF0F}{FF0D}",
  "refs": [
   "1DBF67"
  ]

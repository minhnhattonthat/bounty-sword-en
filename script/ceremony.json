 {
  "id": "1DEBD5",
  "kind": "text",
  "jp": "　星に導かれし宿命の者よ，よくぞ参られた。{FF01}　我らは，指輪に封印されし十二の神々なり。{FF10:ECA9:00DD}{FF11}{FF03}",
  "en": " Welcome, star-guided one.{FF01} We are the Twelve Gods.{FF10:ECA9:00DD}{FF11}{FF03}"
 },
 {
  "id": "1DEC35",
  "kind": "text",
  "jp": "　エウロペアの大地の契約にもとづき，{FF01}　これよりぎしきを行う。{FF10:ECA9:00DD}{FF11}{FF03}",
  "en": " By our pact with Europea,{FF01} the ceremony now begins.{FF10:ECA9:00DD}{FF11}{FF03}"
 },
 {
  "id": "1DEC7D",
  "kind": "text",
  "jp": "　まず，なんじの運命の日を[01DE]えよ。{FF10:ECA9:00DD}{FF11}{FF0D}",
  "en": " First, tell us the day{FF01} of thy destiny.{FF10:ECA9:00DD}{FF11}{FF0D}"
 },
